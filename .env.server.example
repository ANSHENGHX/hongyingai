APP_ENV=production
APP_LOG_LEVEL=INFO
APP_SERVICE_NAME=ai-api
APP_WORK_DIR=/work

# This should point to the host MySQL instance from inside Docker.
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_DATABASE=ai_platform
MYSQL_USERNAME=hongyingai
MYSQL_PASSWORD=change-me

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=change-me
RABBITMQ_VHOST=/

MINIO_ENDPOINT=http://minio:9000
MINIO_CONSOLE_ENDPOINT=http://minio:9001
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=hongying
MINIO_SECURE=false

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

MODEL_PROVIDER=kimi
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_API_KEY=
KIMI_MODEL=moonshot-v1-8k

BAIDU_TTS_API_KEY=
BAIDU_TTS_SHORT_URL=https://tsn.baidu.com/text2audio
BAIDU_TTS_VOICE=5003
BAIDU_TTS_SPEED=5
BAIDU_TTS_PITCH=5
BAIDU_TTS_VOLUME=8

ARK_MEDIA_ENABLED=false
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=
ARK_IMAGE_MODEL=
ARK_VIDEO_MODEL=
ARK_TIMEOUT_SECONDS=900
ARK_POLL_INTERVAL_SECONDS=3
AI_VIDEO_CLIP_DURATION_SECONDS=5
AI_VIDEO_MIN_CLIP_COUNT=3
AI_VIDEO_MAX_CLIP_COUNT=6

FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FFMPEG_PRESET_VERSION=v1
INTERNAL_SERVICE_ALLOWLIST=video-task-service,material-service,work-service,ops-console
WORKER_KIND=parser
STUDIO_DIRECT_EXECUTION=true
