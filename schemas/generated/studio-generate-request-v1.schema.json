{
  "$defs": {
    "AssetManifestEntry": {
      "additionalProperties": false,
      "properties": {
        "assetId": {
          "title": "Assetid",
          "type": "string"
        },
        "objectKey": {
          "title": "Objectkey",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-fA-F]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "durationMs": {
          "exclusiveMinimum": 0,
          "title": "Durationms",
          "type": "integer"
        },
        "sizeBytes": {
          "exclusiveMinimum": 0,
          "title": "Sizebytes",
          "type": "integer"
        },
        "etag": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Etag"
        },
        "licenseId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Licenseid"
        },
        "focusX": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Focusx"
        },
        "focusY": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Focusy"
        },
        "mediaType": {
          "default": "video",
          "enum": [
            "video",
            "image",
            "audio"
          ],
          "title": "Mediatype",
          "type": "string"
        },
        "hasAudio": {
          "default": true,
          "title": "Hasaudio",
          "type": "boolean"
        },
        "labels": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Labels",
          "type": "array"
        },
        "qualityScore": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Qualityscore"
        }
      },
      "required": [
        "assetId",
        "objectKey",
        "sha256",
        "durationMs",
        "sizeBytes"
      ],
      "title": "AssetManifestEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "merchantId": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Merchantid",
      "type": "string"
    },
    "merchantName": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Merchantname",
      "type": "string"
    },
    "activityId": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Activityid",
      "type": "string"
    },
    "activityTitle": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Activitytitle",
      "type": "string"
    },
    "activityType": {
      "default": "营销活动",
      "maxLength": 100,
      "title": "Activitytype",
      "type": "string"
    },
    "userGoal": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Usergoal",
      "type": "string"
    },
    "templateId": {
      "title": "Templateid",
      "type": "string"
    },
    "assets": {
      "items": {
        "$ref": "#/$defs/AssetManifestEntry"
      },
      "minItems": 1,
      "title": "Assets",
      "type": "array"
    },
    "logoAssetId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Logoassetid"
    },
    "bgmAssetId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Bgmassetid"
    },
    "sellingPoints": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Sellingpoints",
      "type": "array"
    },
    "forbiddenWords": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Forbiddenwords",
      "type": "array"
    },
    "useAi": {
      "default": true,
      "title": "Useai",
      "type": "boolean"
    }
  },
  "required": [
    "merchantId",
    "merchantName",
    "activityId",
    "activityTitle",
    "userGoal",
    "templateId",
    "assets"
  ],
  "title": "StudioGenerateRequest",
  "type": "object"
}